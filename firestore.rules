rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{document=**} { allow read: if true; allow write: if false; }
    match /fixtures/{document=**} { allow read: if true; allow write: if false; }
    match /stories/{document=**} { allow read: if true; allow write: if false; }
    match /playerStats/{document=**} { allow read: if true; allow write: if false; }
    match /weeklyDigest/{document=**} { allow read: if true; allow write: if false; }
    match /standings/{document=**} { allow read: if true; allow write: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
